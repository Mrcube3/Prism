# PRISM configuration. Copy to .env.local and fill in. Never commit .env.local.

# Bitget UTA API key: create it READ-ONLY (no trade, transfer or withdrawal). PRISM only sends GET requests.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# 1 for a Bitget demo-trading (paper) key. Demo data is never treated as live.
BITGET_DEMO_TRADING=0
BITGET_API_BASE_URL=https://api.bitget.com

# Qwen (parses requests and explains results; never computes numbers)
BITGET_QWEN_API_KEY=
BITGET_QWEN_BASE_URL=https://hackathon.bitgetops.com/v1
BITGET_QWEN_MODEL=qwen3.8-max

# Contact address SEC EDGAR requires in the User-Agent (use a project address, not a personal one).
PRISM_SEC_CONTACT=ops@getprismpulse.xyz

# Optional: set to require a password (HTTP Basic, any username) for the public account view.
PRISM_ACCOUNT_PASSWORD=
